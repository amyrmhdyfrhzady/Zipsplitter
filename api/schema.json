{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/filesplitter/response.schema.json",
  "title": "FileSplitter result",
  "description": "Successful result document stored as response.json in the output GitHub Release. It contains only direct URLs for the generated parts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["parts"],
  "properties": {
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://github\\.com/.+/releases/download/.+\\.zip$"
      }
    }
  }
}
